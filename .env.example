# Hugging Face Access Token để stream dataset GD-Studio/embeat_45m_spotify_tracks
# Lấy token tại: https://huggingface.co/settings/tokens
# Lưu ý: Cần bấm "Accept License" tại https://huggingface.co/datasets/GD-Studio/embeat_45m_spotify_tracks
HF_TOKEN=hf_your_access_token_here

# Chế độ nạp dữ liệu (full | compact | sample)
DATA_SCALE_MODE=sample
SAMPLE_RATIO=0.5

# ==========================================
# Full Audio Resolver (Kiến trúc MusicFab / RapidAPI)
# Nếu để trống RAPIDAPI_KEY, hệ thống tự động fallback về nghe thử 30s (Spotify Embed / iTunes)
# ==========================================
RAPIDAPI_KEY=3fd3463171mshd503408b87dc60ap1d9561jsnc72f4940b57e
RAPIDAPI_TIMEOUT_MS=30000
SPOTIFY_METADATA_HOST=spotify-web-api3.p.rapidapi.com
SPOTIFY_MP3_HOST=spotify-mp3-converter-downloader.p.rapidapi.com
SPOTIFY_BACKUP_DOWNLOAD_HOST=spotify-downloader9.p.rapidapi.com
# RapidAPI Integration (MusicFab / Spodown technique for full-length audio tracks)
RAPIDAPI_KEY=3fd3463171mshd503408b87dc60ap1d9561jsnc72f4940b57e
RAPIDAPI_TIMEOUT_MS=12000

# Vì bạn đang dùng API spotify-downloader9 của tác giả amiteshgupta:
SPOTIFY_MP3_HOST=spotify-downloader9.p.rapidapi.com
SPOTIFY_BACKUP_DOWNLOAD_HOST=spotify-downloader9.p.rapidapi.com
SPOTIFY_METADATA_HOST=spotify-web-api3.p.rapidapi.com



